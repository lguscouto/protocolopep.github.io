{
  "name": "pep-protocol",
  "version": "3.9.10",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "private": true,
  "description": "App Android/PWA Local-First para registrar tratamentos, receber lembretes e consultar o histórico.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:performance": "npm run build && node scripts/performance.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && .\\gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.6.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
